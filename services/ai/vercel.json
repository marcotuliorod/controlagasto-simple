{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "services": {
    "ai": {
      "runtime": "container",
      "root": "./"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "ai" }
    }
  ]
}
