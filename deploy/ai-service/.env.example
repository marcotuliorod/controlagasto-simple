# Copie para .env nesta mesma pasta na VPS (chmod 600), preenchido com
# valores reais. NUNCA commitar o .env preenchido.
#
# Este .env também é lido pelo próprio `docker compose` (interpolação de
# variáveis no docker-compose.yml, ex. ${AI_DOMAIN} na label do Traefik) além
# de ser injetado no container via `env_file`.

# Subdomínio deste serviço. O Traefik já provisionado pela Hostinger
# (/docker/traefik na VPS, não faz parte deste repo) descobre o serviço pelas
# labels do docker-compose.yml e emite TLS via Let's Encrypt automaticamente
# para este host — precisa ter um registro DNS A apontando para o IP da VPS
# antes do primeiro `docker compose up`.
AI_DOMAIN=ai.SEU-DOMINIO.com

# Chave do provedor de IA. Nunca deve chegar ao browser.
GEMINI_API_KEY=

# URL do projeto Supabase gerenciado — resolve o JWKS (ES256) pelo `kid`
# do token, para validar o JWT do usuário.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Opcional, mas recomendado: cobre a família HS256 também, o que evita
# precisar de redeploy quando a chave assimétrica do Supabase rotacionar.
# Pegue em Project Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=

# CORS. Quem chama este serviço em produção é a Edge Function, servidor a
# servidor (sem header Origin) — este valor só importa para chamadas diretas
# do browser (ex.: debug local). Pode deixar o default.
ALLOWED_ORIGINS=http://localhost:8080
